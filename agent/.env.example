# The agent's own wallet. It is the `provider` on every job it answers, and the
# only account the kernel will accept a submit() from.
AGENT_PRIVATE_KEY=

# Where deliverables are served from. Written into optParams as
# {"deliverable_url": "..."} so a client can read the report the hash commits to.
PUBLIC_BASE_URL=https://usebazar.xyz/agent

# Optional. Defaults to a public BSC endpoint.
BSC_RPC_URL=https://bsc-dataseed.binance.org

# eth_getLogs endpoint. Kept separate because the Binance dataseed nodes refuse
# log queries over any range; publicnode serves 2000 blocks.
BSC_LOGS_RPC_URL=https://bsc-rpc.publicnode.com
